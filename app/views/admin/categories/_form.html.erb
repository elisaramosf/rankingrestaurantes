<%= form_with model: [:admin, category] do |form| %>
  <% if category.errors.any? %>
    <ul style="color:red">
      <% category.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :name, "Nombre" %><br>
    <%= form.text_field :name %>
  </div>

  <%= form.submit "Guardar" %>
<% end %>