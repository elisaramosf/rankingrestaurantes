<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rankingrestaurantes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rankingrestaurantes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      * { box-sizing: border-box; }

      body {
        font-family: 'Helvetica Neue', Arial, sans-serif;
        background-color: #F7F5F0;
        color: #5C544D;
        margin: 0;
        padding: 60px 40px;
        line-height: 1.6;
      }

      a {
        color: #A39171;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
      }
      a:hover { color: #5C544D; }

      /* --- BARRA SUPERIOR --- */
      .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #FFFFFF;
        border-bottom: 1px solid #E8E3D9;
        padding: 18px 40px;
        margin: -60px -40px 40px;
      }

      .navbar-brand {
        color: #3B3631;
        font-size: 1.1em;
        letter-spacing: 0.5px;
      }

      .navbar-brand small {
        margin-left: 10px;
        font-size: 0.6em;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #A39171;
      }

      .navbar-links a {
        margin: 0 20px;
        font-size: 0.85em;
        font-weight: 600;
        color: #6B6154;
        text-transform: uppercase;
        letter-spacing: 1.5px;
      }
      .navbar-links a:hover { color: #3B3631; }

      .navbar form {
        margin: 0;
        padding: 0;
        max-width: none;
        background: transparent;
        border: none;
        box-shadow: none;
      }
      .navbar button {
        width: auto;
        padding: 10px 18px;
      }

      h1, h2, h3 {
        color: #3B3631;
        font-weight: 400;
        margin-bottom: 40px;
        letter-spacing: 0.5px;
        text-align: center;
      }

      /* --- TABLAS --- */
      table {
        width: 100%;
        max-width: 800px;
        margin: 40px auto;
        border-collapse: collapse;
      }

      th, td {
        padding: 20px 0;
        text-align: left;
        border-bottom: 1px solid #E8E3D9;
      }

      th {
        color: #A39171;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.7em;
        letter-spacing: 1.5px;
      }

      td { vertical-align: middle; }

      td form {
        display: inline-block;
        margin: 0;
        padding: 0;
        background: transparent;
        box-shadow: none;
        border: none;
        max-width: none;
      }

      td input[type="submit"], td button {
        background: transparent;
        color: #C28C84;
        width: auto;
        padding: 0;
        margin-left: 15px;
        font-weight: 500;
        cursor: pointer;
        border: none;
      }

      td input[type="submit"]:hover, td button:hover {
        color: #A16B63;
      }

      /* --- FORMULARIOS (tarjeta) --- */
      form:not(td form) {
        background: #FFFFFF;
        padding: 40px;
        border-radius: 0px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        max-width: 400px;
        margin: 60px auto;
        border: 1px solid #E8E3D9;
      }

      form a {
        display: block;
        text-align: center;
        margin-top: 20px;
        font-size: 0.85em;
        color: #8C847A;
      }
      form a:hover { color: #3B3631; }

      label {
        font-size: 0.75em;
        color: #8C847A;
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      input[type="text"], input[type="email"], input[type="password"], input[type="number"] {
        width: 100%;
        padding: 12px;
        margin-bottom: 25px;
        border: 1px solid #E8E3D9;
        border-radius: 0px;
        background-color: #FCFBFA;
        color: #5C544D;
        outline: none;
        transition: border 0.2s;
      }

      input:focus { border-color: #C2B8A3; }

      input[type="submit"]:not(td input), button:not(td button) {
        background-color: #8A7E6E;
        color: #FFF;
        border: none;
        padding: 14px 20px;
        border-radius: 0px;
        cursor: pointer;
        font-size: 0.85em;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        width: 100%;
        transition: background 0.2s ease;
      }

      input[type="submit"]:hover:not(td input), button:hover:not(td button) {
        background-color: #6B6154;
      }
    </style>
  </head>

  <body>
    <% if authenticated? %>
      <nav class="navbar">
        <%= link_to admin_root_path, class: "navbar-brand" do %>
          Ranking Restaurantes <small>Admin</small>
        <% end %>

        <div class="navbar-links">
          <%= link_to "Categorías", admin_categories_path %>
          <%= link_to "Restaurantes", admin_restaurants_path %>
        </div>

        <%= button_to "Cerrar sesión", session_path, method: :delete %>
      </nav>
    <% end %>

    <%= yield %>
  </body>
</html>